rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'chimhinhin@gmail.com';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function joinedClasses() {
      return get(/databases/$(database)/documents/users_public/$(request.auth.uid)).data.joinedClasses;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /users_public/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /system_settings/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /public_assignments/{assignmentId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.targetClass == '全校' ||
          resource.data.targetClass in joinedClasses()
        )
      );
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
