rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'chimhinhin@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function joinedClasses() {
      return get(/databases/$(database)/documents/users_public/$(request.auth.uid)).data.joinedClasses;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      match /settings/{settingId} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /drafts/{draftId} { allow read, write: if isOwner(userId); }
      match /items/{itemId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin())
          && !request.resource.data.keys().hasAny(['collabRefId'])
          && !itemId.matches('collab_.*');
        allow update: if (isOwner(userId) || isAdmin()) && (
          (!resource.data.keys().hasAny(['collabRefId']) && !request.resource.data.keys().hasAny(['collabRefId']))
          || (isOwner(userId) && resource.data.keys().hasAny(['collabRefId'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed','completedAt','privateNote','isHidden','changedAfterCompletion'])
            && request.resource.data.completed is bool
            && request.resource.data.isHidden is bool
            && request.resource.data.privateNote is string
            && request.resource.data.privateNote.size() <= 2000)
        );
        allow delete: if (isOwner(userId) || isAdmin()) && !resource.data.keys().hasAny(['collabRefId']);
      }
    }

    function groupMember(groupId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/collab_groups/$(groupId)).data.members;
    }
    match /collab_accounts/{uid} { allow read: if isOwner(uid) || isAdmin(); allow write: if false; }
    match /collab_groups/{groupId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.members);
      allow write: if false;
    }
    match /collab_preferences/{uid}/groups/{groupId} { allow read: if isOwner(uid); allow write: if false; }
    match /collab_inbox/{uid}/entries/{entryId} { allow read: if isOwner(uid); allow write: if false; }
    match /collab_assignments/{assignmentId} {
      allow read: if isAdmin() || (signedIn() && (
        resource.data.ownerUid == request.auth.uid
        || (resource.data.groupId != '' && request.auth.uid in resource.data.audience && groupMember(resource.data.groupId))
        || (resource.data.groupId == '' && request.auth.uid in resource.data.acceptedUids)
      ));
      allow write: if false;
    }
    match /collab_reports/{reportId} { allow read: if isAdmin(); allow write: if false; }
    match /collab_audit/{auditId} { allow read: if isAdmin(); allow write: if false; }

    match /users_public/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /system_settings/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /public_assignments/{assignmentId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.targetClass == '全校' ||
          resource.data.targetClass in joinedClasses()
        )
      );
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
