rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'chimhinhin@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function joinedClasses() {
      return get(/databases/$(database)/documents/users_public/$(request.auth.uid)).data.joinedClasses;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      match /settings/{settingId} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /drafts/{draftId} { allow read, write: if isOwner(userId); }
      match /items/{itemId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin())
          && !request.resource.data.keys().hasAny(['collabRefId'])
          && !itemId.matches('collab_.*') && !itemId.matches('spark_.*');
        allow update: if (isOwner(userId) || isAdmin()) && (
          (!resource.data.keys().hasAny(['collabRefId']) && !request.resource.data.keys().hasAny(['collabRefId']))
          || (isOwner(userId) && resource.data.keys().hasAny(['collabRefId'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed','completedAt','privateNote','isHidden','changedAfterCompletion'])
            && request.resource.data.completed is bool
            && request.resource.data.isHidden is bool
            && request.resource.data.privateNote is string
            && request.resource.data.privateNote.size() <= 2000)
        );
        allow delete: if (isOwner(userId) || isAdmin()) && !resource.data.keys().hasAny(['collabRefId']);
      }
    }

    function active() { return signedIn() && get(/databases/$(database)/documents/spark_accounts/$(request.auth.uid)).data.disabled == false; }
    function publisher() { return active() && get(/databases/$(database)/documents/spark_accounts/$(request.auth.uid)).data.canPublish == true; }
    function sg(id) { return get(/databases/$(database)/documents/spark_groups/$(id)).data; }
    function member(id) { return signedIn() && request.auth.uid in sg(id).members; }
    function manager(g) { return request.auth.uid == g.ownerUid || request.auth.uid in g.managers; }
    function unblocked(a,b) {
      return !(a in get(/databases/$(database)/documents/spark_accounts/$(b)).data.blocked)
        && !(b in get(/databases/$(database)/documents/spark_accounts/$(a)).data.blocked)
        && get(/databases/$(database)/documents/spark_accounts/$(b)).data.disabled == false;
    }
    match /spark_accounts/{id} {
      allow get: if isOwner(id) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(id) && request.resource.data.keys().hasOnly(['uid','code','name','blocked','canPublish','disabled','createdAt'])
        && request.resource.data.uid == id && request.resource.data.code.matches('^[A-Z]{5}$')
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.blocked == [] && request.resource.data.disabled == false && request.resource.data.canPublish == true
        && getAfter(/databases/$(database)/documents/spark_codes/$(request.resource.data.code)).data.uid == id;
      allow update: if (isOwner(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blocked'])
          && request.resource.data.blocked is list && request.resource.data.blocked.size() <= 200)
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled','canPublish'])
          && request.resource.data.disabled is bool && request.resource.data.canPublish is bool);
    }
    match /spark_codes/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn() && code.matches('^[A-Z]{5}$')
        && request.resource.data.keys().hasOnly(['uid','code','name']) && request.resource.data.uid == request.auth.uid && request.resource.data.code == code
        && getAfter(/databases/$(database)/documents/spark_accounts/$(request.auth.uid)).data.code == code
        && getAfter(/databases/$(database)/documents/spark_accounts/$(request.auth.uid)).data.name == request.resource.data.name;
    }
    function groupValid(g,id) {
      return g.keys().hasOnly(['id','code','name','description','ownerUid','members','managers','memberNames','banned','allowMemberPublish','state','createdAt','lastRequestId'])
        && g.id == id && g.code == id && id.matches('^G-[A-Z]{6}$')
        && g.name is string && g.name.size() > 0 && g.name.size() <= 60 && g.description is string && g.description.size() <= 300
        && g.members is list && g.members.size() > 0 && g.members.size() <= 60 && g.members.toSet().size() == g.members.size()
        && g.ownerUid in g.members && g.managers is list && g.members.hasAll(g.managers)
        && g.memberNames is map && g.memberNames.keys().toSet() == g.members.toSet()
        && g.banned is list && g.banned.size() <= 200 && !g.members.hasAny(g.banned)
        && g.allowMemberPublish is bool && g.state in ['active','frozen'];
    }
    function joining(g,n,id) {
      let e=getAfter(/databases/$(database)/documents/spark_requests/$(n.lastRequestId)).data;
      let old=get(/databases/$(database)/documents/spark_requests/$(n.lastRequestId)).data;
      return g.state == 'active' && old.status == 'pending' && e.status == 'accepted' && e.groupId == id
        && e.recipientUid == request.auth.uid && e.expiresAt >= request.time.toMillis()
        && ((e.kind == 'invite' && e.memberUid == request.auth.uid && (e.senderUid == g.ownerUid || e.senderUid in g.managers))
          || (e.kind == 'join' && manager(g) && e.memberUid == e.senderUid))
        && !(e.memberUid in g.banned) && !(e.memberUid in g.members)
        && n.members.toSet() == g.members.toSet().union([e.memberUid].toSet())
        && n.memberNames.diff(g.memberNames).affectedKeys().hasOnly([e.memberUid]) && n.memberNames[e.memberUid] == e.memberName
        && n.diff(g).affectedKeys().hasOnly(['members','memberNames','lastRequestId']);
    }
    function removing(g,n) {
      let removed=g.members.removeAll(n.members);
      return removed.size() == 1 && removed[0] != g.ownerUid && g.members.hasAll(n.members)
        && (removed[0] == request.auth.uid || (manager(g) && (!(removed[0] in g.managers) || request.auth.uid == g.ownerUid)))
        && n.managers == g.managers.removeAll(removed)
        && n.memberNames.diff(g.memberNames).affectedKeys().hasOnly(removed)
        && (n.banned == g.banned || (removed[0] != request.auth.uid && n.banned.toSet() == g.banned.toSet().union(removed.toSet())))
        && n.diff(g).affectedKeys().hasOnly(['members','managers','memberNames','banned']);
    }
    match /spark_groups/{id} {
      allow get: if isAdmin() || (signedIn() && (request.auth.uid in resource.data.members
        || get(/databases/$(database)/documents/spark_requests/$('invite_'+id+'_'+request.auth.uid)).data.status == 'pending'));
      allow list: if isAdmin() || (signedIn() && request.auth.uid in resource.data.members);
      allow create: if publisher() && groupValid(request.resource.data,id)
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.members == [request.auth.uid]
        && request.resource.data.managers == [] && request.resource.data.banned == [] && request.resource.data.state == 'active'
        && getAfter(/databases/$(database)/documents/spark_group_codes/$(id)).data.groupId == id;
      allow update: if groupValid(request.resource.data,id) && (
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state']))
        || (active() && (
          joining(resource.data,request.resource.data,id) || removing(resource.data,request.resource.data)
          || (manager(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','allowMemberPublish'])
            && getAfter(/databases/$(database)/documents/spark_group_codes/$(id)).data.name == request.resource.data.name)
          || (request.auth.uid == resource.data.ownerUid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managers','ownerUid'])
            && getAfter(/databases/$(database)/documents/spark_group_codes/$(id)).data.ownerUid == request.resource.data.ownerUid)
        )));
    }
    match /spark_group_codes/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create,update: if active() && request.resource.data.keys().hasOnly(['groupId','code','name','ownerUid'])
        && request.resource.data.groupId == code && request.resource.data.code == code
        && getAfter(/databases/$(database)/documents/spark_groups/$(code)).data.name == request.resource.data.name
        && getAfter(/databases/$(database)/documents/spark_groups/$(code)).data.ownerUid == request.resource.data.ownerUid
        && (request.resource.data.ownerUid == request.auth.uid || manager(sg(code)));
    }
    match /spark_preferences/{id}/groups/{gid} {
      allow read: if isOwner(id);
      allow create,update: if isOwner(id) && member(gid) && request.resource.data.keys().hasOnly(['sync','notify','pinned','archived','since'])
        && request.resource.data.sync is bool && request.resource.data.notify is bool && request.resource.data.pinned is bool
        && request.resource.data.archived is bool && request.resource.data.since is number;
    }
    function requestValid(e) {
      return e.keys().hasOnly(['kind','groupId','assignmentId','senderUid','recipientUid','memberUid','memberName','actorUid','title','description','subject','dueDate','status','read','createdAt','expiresAt'])
        && e.kind in ['invite','join','direct'] && e.senderUid == request.auth.uid && e.actorUid == request.auth.uid
        && e.recipientUid != request.auth.uid && e.status == 'pending' && e.read == false
        && e.createdAt is number && e.expiresAt is number && e.expiresAt <= request.time.toMillis()+15*86400000
        && e.expiresAt > request.time.toMillis() && e.title is string && e.title.size() <= 200
        && e.description is string && e.description.size() <= 2000 && e.memberName is string && e.memberName.size() <= 60
        && unblocked(e.senderUid,e.recipientUid);
    }
    function requestTarget(e,id) {
      return (e.kind == 'invite' && id == 'invite_'+e.groupId+'_'+e.recipientUid && e.memberUid == e.recipientUid
          && manager(sg(e.groupId)) && sg(e.groupId).state == 'active' && !(e.memberUid in sg(e.groupId).members) && !(e.memberUid in sg(e.groupId).banned))
        || (e.kind == 'join' && id == 'join_'+e.groupId+'_'+request.auth.uid && e.memberUid == request.auth.uid
          && e.recipientUid == sg(e.groupId).ownerUid && sg(e.groupId).state == 'active'
          && !(request.auth.uid in sg(e.groupId).members) && !(request.auth.uid in sg(e.groupId).banned))
        || (e.kind == 'direct' && id == 'direct_'+e.assignmentId+'_'+e.recipientUid
          && getAfter(/databases/$(database)/documents/spark_assignments/$(e.assignmentId)).data.ownerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/spark_assignments/$(e.assignmentId)).data.audience == [e.recipientUid]
          && getAfter(/databases/$(database)/documents/spark_assignments/$(e.assignmentId)).data.groupId == '');
    }
    match /spark_requests/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/spark_requests/$(id)) || resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.recipientUid == request.auth.uid || resource.data.senderUid == request.auth.uid || isAdmin());
      allow create: if active() && requestValid(request.resource.data) && requestTarget(request.resource.data,id);
      allow update: if (active() && resource.data.recipientUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','read']) && request.resource.data.read is bool
          && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'pending' && request.resource.data.status in ['accepted','rejected']
              && (request.resource.data.status == 'rejected' || (resource.data.expiresAt >= request.time.toMillis() && unblocked(resource.data.senderUid,request.auth.uid))))))
        || (active() && resource.data.senderUid == request.auth.uid && resource.data.status != 'pending'
          && requestValid(request.resource.data) && requestTarget(request.resource.data,id));
    }
    function sourceReadable(s) {
      return signedIn() && (s.ownerUid == request.auth.uid || (request.auth.uid in s.audience && (s.groupId == '' || member(s.groupId))));
    }
    function sourceValid(s,id) {
      return s.keys().hasOnly(['id','kind','type','subject','description','dueDate','priority','ownerUid','authorName','groupId','groupName','audience','acceptedUids','version','state','createdAt','updatedAt'])
        && s.id == id && s.kind in ['homework','assessment','notice','activity','revision'] && s.type == (s.kind == 'homework' ? 'homework' : 'assessment')
        && s.subject is string && s.subject.size()>0 && s.subject.size()<=40 && s.description is string && s.description.size()>0 && s.description.size()<=2000
        && s.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && s.priority in ['low','normal','high']
        && s.audience is list && s.audience.size()>0 && s.audience.size()<=60 && s.acceptedUids is list && s.audience.hasAll(s.acceptedUids)
        && s.authorName is string && s.authorName.size()<=60 && s.groupName is string && s.groupName.size()<=60
        && s.version is int && s.state in ['active','withdrawn'];
    }
    match /spark_assignments/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/spark_assignments/$(id)) || isAdmin() || sourceReadable(resource.data));
      allow list: if isAdmin() || sourceReadable(resource.data);
      allow create: if publisher() && sourceValid(request.resource.data,id) && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.version == 1 && request.resource.data.state == 'active' && request.resource.data.acceptedUids == []
        && ((request.resource.data.groupId == '' && request.resource.data.audience.size() == 1 && unblocked(request.auth.uid,request.resource.data.audience[0]))
          || (request.resource.data.groupId != '' && member(request.resource.data.groupId) && sg(request.resource.data.groupId).state == 'active'
            && (manager(sg(request.resource.data.groupId)) || sg(request.resource.data.groupId).allowMemberPublish)
            && sg(request.resource.data.groupId).members.hasAll(request.resource.data.audience)));
      allow update: if sourceValid(request.resource.data,id) && (
        (publisher() && resource.data.ownerUid == request.auth.uid && resource.data.state == 'active'
          && (resource.data.groupId == '' || (member(resource.data.groupId) && sg(resource.data.groupId).state == 'active'))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kind','type','subject','description','dueDate','priority','version','updatedAt','state'])
          && request.resource.data.version == resource.data.version+1)
        || (active() && resource.data.groupId == '' && resource.data.audience == [request.auth.uid] && resource.data.state == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedUids']) && request.resource.data.acceptedUids == [request.auth.uid]
          && getAfter(/databases/$(database)/documents/spark_requests/$('direct_'+id+'_'+request.auth.uid)).data.status == 'accepted'));
    }
    function projection(d) {
      let s=get(/databases/$(database)/documents/spark_assignments/$(d.collabRefId)).data;
      return sourceReadable(s) && (s.groupId != '' || request.auth.uid in s.acceptedUids)
        && d.sparkSource == true && d.type == s.type && d.sourceKind == s.kind && d.subject == s.subject && d.description == s.description
        && d.dueDate == s.dueDate && d.priority == s.priority && d.sourceVersion == s.version && d.sourceUpdatedAt == s.updatedAt
        && d.sourceGroupId == s.groupId && d.sourceGroupName == (s.groupId == '' ? '私人發放' : s.groupName)
        && d.senderName == s.authorName && d.withdrawn == (s.state == 'withdrawn') && d.forceExpired == d.withdrawn;
    }
    function privateFields(d) { return d.completed is bool && d.isHidden is bool && d.privateNote is string && d.privateNote.size() <= 2000; }
    match /users/{id}/items/{item} {
      allow create: if isOwner(id) && item == 'spark_'+request.resource.data.collabRefId && projection(request.resource.data) && privateFields(request.resource.data);
      allow update: if isOwner(id) && resource.data.get('sparkSource',false) == true
        && request.resource.data.collabRefId == resource.data.collabRefId && privateFields(request.resource.data)
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed','completedAt','privateNote','isHidden','changedAfterCompletion'])
          || projection(request.resource.data));
    }
    match /spark_inbox/{id}/entries/{entry} {
      allow read,delete: if isOwner(id);
      allow create,update: if isOwner(id) && request.resource.data.keys().hasOnly(['title','description','subject','dueDate','groupId','actorUid','status','read','createdAt'])
        && request.resource.data.status == 'info' && request.resource.data.title is string && request.resource.data.title.size()<=200
        && request.resource.data.description is string && request.resource.data.description.size()<=2000 && request.resource.data.read is bool;
    }
    match /spark_reports/{id} {
      allow read: if isAdmin();
      allow create: if active() && request.resource.data.keys().hasOnly(['actorUid','targetType','targetId','reason','state','createdAt'])
        && request.resource.data.actorUid == request.auth.uid && request.resource.data.state == 'open'
        && request.resource.data.reason is string && request.resource.data.reason.size()>0 && request.resource.data.reason.size()<=1000;
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state']) && request.resource.data.state == 'resolved';
    }
    match /spark_audit/{id} { allow read,create: if isAdmin(); }

    match /users_public/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /system_settings/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /public_assignments/{assignmentId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.targetClass == '全校' ||
          resource.data.targetClass in joinedClasses()
        )
      );
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
