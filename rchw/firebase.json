{
  "functions": [
    {
      "source": ".",
      "codebase": "studyos-collaboration",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.html",
        "*.css",
        "*.jsx",
        "*.md",
        "*.txt",
        "*.svg",
        "*.webmanifest",
        "*test*",
        "build.mjs",
        "firebase.json",
        "firestore.*",
        "app.js",
        "collaboration.js",
        "react.js",
        "react-dom.js",
        "lucide.js",
        "qrcode.js",
        "sw.js"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "*.zip",
      "*.log",
      "server.js",
      "service.js",
      "package*.json",
      "build.mjs",
      "*test*",
      "*source*",
      "firestore.*",
      "*.md",
      "*.txt"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
